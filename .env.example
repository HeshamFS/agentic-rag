# RAG Optimizer Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=your-qdrant-cloud-api-key

# =============================================================================
# Embedding Model
# =============================================================================
RAG_EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-1.5B-instruct
RAG_EMBEDDING_DEVICE=cuda  # cuda, cpu, mps

# =============================================================================
# LLM Providers (configure the ones you want to use)
# =============================================================================

# Default provider: claude, openai, gemini, local
RAG_LLM_PROVIDER=claude

# Latest Models (2025/2026):
# - Claude: claude-sonnet-4-5-20250929, claude-opus-4-5-20251101
# - OpenAI: gpt-5.2, gpt-5-mini, gpt-5-nano
# - Gemini: gemini-3-pro-preview, gemini-3-flash-preview, gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite
RAG_LLM_MODEL=claude-sonnet-4-5-20250929

# Anthropic (Claude)
RAG_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# RAG_OPENAI_API_KEY=sk-...
# RAG_OPENAI_BASE_URL=  # Optional: for Azure or proxies

# Google (Gemini)
# RAG_GOOGLE_API_KEY=...
# RAG_GEMINI_THINKING_LEVEL=low  # Gemini 3 only: low, medium, high

# Local (Ollama)
# RAG_LOCAL_LLM_URL=http://localhost:11434
# RAG_LOCAL_LLM_MODEL=qwen2.5:7b

# =============================================================================
# Generation Parameters
# =============================================================================
RAG_DEFAULT_TEMPERATURE=0.3
RAG_DEFAULT_MAX_TOKENS=4096

# =============================================================================
# Agentic Parameters
# =============================================================================
RAG_ENABLE_REFLECTION=true
RAG_ENABLE_PLANNING=true
RAG_MAX_ITERATIONS=3
RAG_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# Observability
# =============================================================================
RAG_ENABLE_TRACING=true
RAG_LOG_LEVEL=INFO
# RAG_TRACE_EXPORT_URL=http://localhost:4317  # OTLP endpoint
